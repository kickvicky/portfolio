# Copy to .env.local for local development. On Vercel, set these in Project → Settings → Environment Variables.

# Contact form (https://resend.com). If unset in development, messages are logged to the terminal instead of sent.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# Must be a sender on a domain verified in Resend. The default test sender only delivers to your Resend account email.
CONTACT_FROM_EMAIL="Portfolio <onboarding@resend.dev>"

# Canonical site URL used for metadata, sitemap and robots.txt. On Vercel this falls back to VERCEL_PROJECT_PRODUCTION_URL.
NEXT_PUBLIC_SITE_URL=
